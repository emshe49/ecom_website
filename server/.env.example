NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_random_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_random_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Delivery (Optional in Development, logs to console if empty)
EMAIL_FROM=noreply@ecommerce.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
