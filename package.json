{
  "name": "ecommerce-modular-monolith",
  "version": "1.0.0",
  "private": true,
  "description": "Production-style full-stack e-commerce platform built as a modular monolith.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build:server && npm run build:client",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "test": "npm run test --workspace=server",
    "lint": "npm run lint --workspaces --if-present",
    "lint:client": "npm run lint --workspace=client",
    "lint:server": "npm run lint --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  }
}
